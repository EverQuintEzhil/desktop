{
    "name": "@thefluentmind/design-system",
    "version": "1.0.5",
    "private": false,
    "description": "Pre-styled shadcn primitives for FluentMind GenUI apps — ships self-contained precompiled CSS that resolves against the host product's design tokens.",
    "license": "UNLICENSED",
    "files": [
        "dist",
        "styles",
        "src"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tailwind.css": {
            "style": "./styles/tailwind.css",
            "default": "./styles/tailwind.css"
        },
        "./index.css": "./dist/index.css",
        "./tokens.css": "./dist/tokens.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "npm run build:js && npm run build:types && npm run build:css && npm run build:tokens",
        "build:js": "vite build",
        "build:types": "rollup -c rollup.dts.config.mjs",
        "build:css": "tailwindcss -i styles/index.css -o dist/index.css",
        "build:tokens": "cp styles/tokens.css dist/tokens.css",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.21.0",
        "radix-ui": "^1.6.0",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@rollup/plugin-alias": "^5.1.1",
        "@tailwindcss/cli": "^4.3.1",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "6.0.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "rollup": "^4.52.0",
        "rollup-plugin-dts": "^6.2.3",
        "tailwindcss": "^4.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "overrides": {
        "@babel/plugin-transform-runtime": "^7.29.0"
    },
    "engines": {
        "node": ">=18"
    }
}
